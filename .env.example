# LegoSearch — variables de entorno (copia a .env o configúralas en Railway).
# El .env real NO se sube al repo.

# --- Necesaria ---------------------------------------------------------------
# Sin ella no hay PVP oficial ni fechas de retirada; el motor funciona a ciegas.
# Se obtiene gratis en https://brickset.com/tools/webservices/requestkey
BRICKSET_API_KEY=

# --- Worker / cron (Railway / Docker) ----------------------------------------
# 1 = proceso continuo; 0 o vacío = una sola pasada y salir.
# Con Cron Schedule en Railway se usa 0: el contenedor escanea y termina.
LOOP_MODE=0
# Minutos entre escaneos. 1440 = cada 24 h; 2880 = cada 48 h.
# Ojo: cada escaneo consulta Brickset (límite de ~100/día con clave gratuita);
# un ciclo gasta ~58 consultas, así que 24 h deja margen de sobra.
LEGO_REVISION_MINUTOS=1440
# Alias antiguo de la variable anterior (se sigue aceptando).
# SCAN_INTERVAL_MINUTES=1440
# Dónde se guarda el histórico (en Docker: volumen persistente).
LEGOSEARCH_OUTPUT=/app/data/opportunities.json

# --- Publicación en GitHub (la necesita el superagente) ----------------------
# El superagente de Telegram lee SIEMPRE de la rama runtime-data, no del
# volumen de Railway. Sin token, los escaneos quedan solo en /app/data y el
# bot no los verá.
#
# Token con permiso "Contents: Read and write" SÓLO sobre este repo
# (fine-grained token). No hace falta ningún otro permiso.
GITHUB_PUBLISH_TOKEN=
# Repo y rama de destino (tienen valores por defecto; solo para forks).
# GITHUB_PUBLISH_REPO=mpinartr/LegoSearch
# GITHUB_PUBLISH_BRANCH=runtime-data
