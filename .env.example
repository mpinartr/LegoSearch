# LegoSearch — variables de entorno (copia a .env o configúralas en Railway).
# El .env real NO se sube al repo.

# --- Necesaria ---------------------------------------------------------------
# Sin ella no hay PVP oficial ni fechas de retirada; el motor funciona a ciegas.
# Se obtiene gratis en https://brickset.com/tools/webservices/requestkey
BRICKSET_API_KEY=

# --- Worker (Railway / Docker) ----------------------------------------------
# 1 = proceso continuo; 0 o vacío = una sola pasada y salir.
LOOP_MODE=1
# Minutos entre escaneos. 360 = cada 6 h. Ojo: cada escaneo consulta Brickset,
# que tiene un límite diario de peticiones con clave gratuita.
LEGO_REVISION_MINUTOS=360
# Alias antiguo de la variable anterior (se sigue aceptando).
# SCAN_INTERVAL_MINUTES=360
# Dónde se guarda el histórico (en Docker: volumen persistente).
LEGOSEARCH_OUTPUT=/app/data/opportunities.json
